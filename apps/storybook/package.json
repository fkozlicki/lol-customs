{
  "name": "@v1/storybook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:stories": "vitest run",
    "clean": "git clean -xdf .turbo node_modules storybook-static coverage",
    "lint": "biome lint",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:stories:watch": "vitest",
    "test:stories:coverage": "vitest run --coverage",
    "chromatic": "bun run build-storybook --stats-json && chromatic --storybook-build-dir storybook-static --only-changed --exit-zero-on-changes"
  },
  "dependencies": {
    "@v1/ui": "workspace:*",
    "next": "catalog:react",
    "next-intl": "^4.14.8",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@v1/typescript": "workspace:*",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "chromatic": "^18.10.1",
    "motion": "^13.4.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "storybook": "^10.6.1",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
